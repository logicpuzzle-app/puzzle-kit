{
  "name": "puzzle-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/core.d.ts",
      "default": "./dist/lib/core.js"
    },
    "./core": {
      "types": "./dist/lib/core.d.ts",
      "default": "./dist/lib/core.js"
    },
    "./compat": {
      "types": "./dist/lib/compat.d.ts",
      "default": "./dist/lib/compat.js"
    },
    "./runtime": {
      "types": "./dist/lib/runtime.d.ts",
      "default": "./dist/lib/runtime.js"
    },
    "./react": {
      "types": "./dist/lib/react.d.ts",
      "default": "./dist/lib/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/library-usage.md",
    "docs/embedded-example.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:npgen-wasm": "node scripts/build-npgen-wasm.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "i18next": "^25.6.3",
    "lucide-react": "^0.556.0",
    "lz-string": "^1.5.0",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.5.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.7",
    "vitest": "^4.0.14"
  }
}
